# Postgres (stands in for "PostgreSQL Flexible Server" in the diagram)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo

# Azurite (local emulator standing in for Azure "Blob Storage")
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=uploads

# Redis + BullMQ (stands in for the queue side of "Service Bus")
REDIS_HOST=localhost
REDIS_PORT=6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
