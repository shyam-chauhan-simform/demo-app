# Postgres (stands in for "PostgreSQL Flexible Server" in the diagram)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo
# Set to "true" when pointing at Azure Database for PostgreSQL Flexible Server (it requires TLS)
POSTGRES_SSL=false

# Azurite (local emulator standing in for Azure "Blob Storage")
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=uploads

# Redis + BullMQ (stands in for the queue side of "Service Bus")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" when pointing at Azure Managed Redis / Azure Cache for Redis (both require TLS)
REDIS_TLS=false

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
